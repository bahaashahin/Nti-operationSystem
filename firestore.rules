rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function role() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role; }
    function lead() { return signedIn() && role() == 'lead'; }
    function coordinator(email) { return signedIn() && role() == 'coordinator' && request.auth.token.email == email; }
    match /users/{id} {
      allow read: if signedIn() && (request.auth.uid == id || lead());
      allow write: if lead();
    }
    match /groups/{id} {
      allow read: if lead() || coordinator(resource.data.coordinatorEmail);
      allow write: if lead();
    }
    match /students/{id} {
      allow read: if lead() || coordinator(resource.data.coordinatorEmail);
      allow create, delete: if lead();
      allow update: if lead() || (coordinator(resource.data.coordinatorEmail)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt','updatedBy'])
        && request.resource.data.coordinatorEmail == resource.data.coordinatorEmail);
    }
  }
}
